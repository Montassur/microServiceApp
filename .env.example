# ==========================================
# Environment Configuration — TEMPLATE
# Copy to .env and edit for your environment.
# For local Docker Compose, simply use .env.development.
# ==========================================
NODE_ENV=development
APP_NAME=Ecommerce

# Domain
DOMAIN=localhost
FRONTEND_URL=http://localhost:9080
ADMIN_URL=http://localhost:8081
API_URL=http://localhost:3080/api

# Internal service URLs
CATALOG_SERVICE_URL=http://catalog:3001
ORDER_PAYMENT_SERVICE_URL=http://order-payment:3002
FULFILLMENT_SERVICE_URL=http://fulfillment:3003
SHOPPING_SERVICE_URL=http://shopping:3004
PLATFORM_SERVICE_URL=http://platform:3005
USER_COMM_SERVICE_URL=http://user-auth:3000
INVENTORY_SERVICE_URL=http://inventory:3006
GATEWAY_URL=http://gateway

# Secrets — REPLACE WITH STRONG RANDOM VALUES (use `openssl rand -hex 32`)
SECRET_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SIGNING_SECRET

# PostgreSQL
DB_HOST=database
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=ecommerce_user
DB_PASSWORD=password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Feature flags
ENABLE_ANALYTICS=true
ENABLE_MONITORING=true

# Stripe — publishable key, exposed to browser (safe)
VITE_STRIPE_PUBLIC_KEY=pk_test_51TWjwfBfBasNNYprUL9GEd5EPWKqBXCMbRxZXdw1lWufbEwgcqQlD1GUcmuqxJUFikLzLYDyP1vt81sFBGioEQ4t00MKkv8pCd
