# ==========================================
# Environment Configuration (PRODUCTION)
# ==========================================
NODE_ENV=production
APP_NAME=Ecommerce

# Public domain (real)
DOMAIN=monta.dev.montassar-benaziza.com
FRONTEND_URL=https://ecommerce.monta.dev.montassar-benaziza.com
ADMIN_URL=https://admin.monta.dev.montassar-benaziza.com
API_URL=https://api.monta.dev.montassar-benaziza.com

# Internal service URLs (K8s Service DNS)
CATALOG_SERVICE_URL=http://catalog:3001
ORDER_PAYMENT_SERVICE_URL=http://order-payment:3002
FULFILLMENT_SERVICE_URL=http://fulfillment:3003
SHOPPING_SERVICE_URL=http://shopping:3004
PLATFORM_SERVICE_URL=http://platform:3005
USER_COMM_SERVICE_URL=http://user-auth:3000
INVENTORY_SERVICE_URL=http://inventory:3006
GATEWAY_URL=http://gateway

# Secrets — REAL VALUES live in the SealedSecret, not here.
# These placeholders document which keys must exist.
SECRET_KEY=FROM_SEALED_SECRET
JWT_SECRET=FROM_SEALED_SECRET
JWT_REFRESH_SECRET=FROM_SEALED_SECRET
STRIPE_SECRET_KEY=FROM_SEALED_SECRET
STRIPE_WEBHOOK_SECRET=whsec_RBMY0KXpuPntagut7kckv4TXRjq4mfbf

# PostgreSQL — K8s Service name "postgres"
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=ecommerce_user
DB_PASSWORD=FROM_SEALED_SECRET

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# RabbitMQ — user "ecommerce_admin" provisioned by the broker container env
RABBITMQ_USER=ecommerce_admin
RABBITMQ_PASS=FROM_SEALED_SECRET
RABBITMQ_URL=amqp://ecommerce_admin:FROM_SEALED_SECRET@rabbitmq:5672

# Feature flags
ENABLE_ANALYTICS=true
ENABLE_MONITORING=true

# Stripe — publishable key, exposed to browser (safe)
VITE_STRIPE_PUBLIC_KEY=pk_test_51TWjwfBfBasNNYprUL9GEd5EPWKqBXCMbRxZXdw1lWufbEwgcqQlD1GUcmuqxJUFikLzLYDyP1vt81sFBGioEQ4t00MKkv8pCd

# SMTP — outbound email (used for 2FA codes, order receipts, etc.)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=no-reply@montassar-benaziza.com
SMTP_PASS=rayenne321
SMTP_FROM=no-reply@montassar-benaziza.com
